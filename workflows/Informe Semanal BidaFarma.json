ame":"Get many database pages","alwaysOutputData":true,"credentials":{"notionApi":{"id":"HeOHvHqVmJrythVH","name":"Notion account"}}},{"parameters":{"resource":"table","workbook":{"__rl":true,"value":"={{ $node[\"Copy a file\"].json[\"location\"].split('items/')[1].split('?')[0] }}","mode":"id"},"worksheet":{"__rl":true,"value":"{00000000-0001-0000-0000-000000000000}","mode":"list","cachedResultName":"Sheet1"},"table":{"__rl":true,"value":"{F8B72853-FF46-47A9-ABD8-D095E11A78D8}","mode":"list","cachedResultName":"Table2"},"fieldsUi":{"values":[{"column":"=Departamento Asociado","fieldValue":"={{ $json['Departamento Asociado'] }}"},{"column":"=Nombre del Proyecto","fieldValue":"={{ $json['Nombre del Proyecto'] }}"},{"column":"=Responsable","fieldValue":"={{ $json.Responsable }}"},{"column":"=Estado del Proyecto","fieldValue":"={{ $json['Estado del Proyecto'] }}"},{"column":"=Prioridad","fieldValue":"={{ $json.Prioridad }}"},{"column":"=Fecha Inicio","fieldValue":"={{ $json['Fecha Inicio'] }}"},{"column":"=Estado de la Facturacion","fieldValue":"={{ $json['Estado de la Facturacion'] }}"},{"column":"=Comentario de la Facturacion","fieldValue":"={{ $json['Comentario de la  Facturacion'] }}"},{"column":"=Fecha Fin","fieldValue":"={{ $json['Fecha Fin'] }}"},{"column":"Descripcion Breve","fieldValue":"={{ $json['Descripcion Breve'] }}"}]},"options":{}},"type":"n8n-nodes-base.microsoftExcel","typeVersion":2.2,"position":[1344,-96],"id":"4c015b28-35e8-4a29-9f3a-91b0cd6e2026","name":"Append rows to table","alwaysOutputData":false,"retryOnFail":false,"credentials":{"microsoftExcelOAuth2Api":{"id":"2VwlIrPUNIHsY8HQ","name":"Microsoft Excel account"}}},{"parameters":{"jsCode":"const items = $input.all();\n\nreturn items.map(item => {\n  const rawData = item.json;\n  const flatData = {};\n\n  for (const key in rawData) {\n    const value = rawData[key];\n    \n    // 1. Quitar el prefijo property_\n    let cleanKey = key.startsWith('property_') ? key.replace('property_', '') : key;\n\n    // 2. Corregir caracteres especiales\n    cleanKey = cleanKey\n      .replace('an_lisis', 'analisis')\n      .replace('validaci_n', 'validacion')\n      .replace('facturaci_n', 'facturacion')\n      .replace('producci_n', 'produccion');\n\n    // 3. Procesar fechas con etiquetas \"start:\" y \"end:\"\n    if (value && typeof value === 'object' && value.hasOwnProperty('start')) {\n      // Creamos dos columnas nuevas basadas en el nombre original (ej: project_dates_start)\n      flatData[`${cleanKey}_start`] = value.start || \"\";\n      flatData[`${cleanKey}_end`] = value.end || \"\";\n    }\n    // MODIFICACIÓN ÚNICAMENTE AQUÍ: Limpieza de Arrays para quitar [\"\"]\n    else if (Array.isArray(value)) {\n      flatData[cleanKey] = value.map(v => {\n        if (typeof v === 'string') return v; \n        if (v.name) return v.name;\n        if (v.plain_text) return v.plain_text;\n        return JSON.stringify(v);\n      }).join(', ');\n    }\n    else {\n      flatData[cleanKey] = value === null ? \"\" : value;\n    }\n  }\n  // 4. Cambio de nomres\n  const finalData = {\n    \"Nombre del Proyecto\": flatData.project_name || \"\",\n    \"Descripcion Breve\": flatData.description_breve || \"\",\n    \"Estado del Proyecto\": flatData.status || \"\",\n    \"Prioridad\": flatData.priority || \"\",\n    \"Responsable\": flatData.owner || \"\",\n    \"Departamento Asociado\": flatData.departamento || \"\",\n    \"Fecha Inicio\": flatData.project_dates_start || \"\",\n    \"Fecha Fin\": flatData.project_dates_end || \"\",\n    \"Comentario de la  Facturacion\": flatData.comentario_facturacion || \"\",\n    \"Estado de la Facturacion\": flatData.estado_facturacion || \"\"\n  };\n\n  return { json: finalData };\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1120,-304],"id":"91902386-16ba-4d5c-a8b4-92358edd664b","name":"Code (Limpieza de tabla)"},{"parameters":{"rule":{"interval":[{"field":"weeks","triggerAtDay":[5],"triggerAtHour":8,"triggerAtMinute":1